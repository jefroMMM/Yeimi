{
  "name": "hotel-aurora", "version": "1.0.0", "private": true,
  "scripts": {
    "start": "node server.js", "start:test": "node server.js --test",
    "db:seed": "node server.js --seed", "db:seed:test": "node server.js --test --seed",
    "typecheck": "tsc --noEmit", "test:api": "node --test tests/api.test.js",
    "cy:open": "cypress open", "cy:run": "node scripts/run-e2e.js",
    "cy:reverse": "node scripts/run-e2e.js --reverse",
