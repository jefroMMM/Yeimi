    "test:e2e:reverse": "node scripts/test-e2e.js --reverse"
  },
  "engines": { "node": ">=22.13.0" },
  "dependencies": { "express": "^5.1.0" },
  "devDependencies": { "cypress": "^15.0.0", "typescript": "^5.9.0", "@types/node": "^22.0.0" }
}
